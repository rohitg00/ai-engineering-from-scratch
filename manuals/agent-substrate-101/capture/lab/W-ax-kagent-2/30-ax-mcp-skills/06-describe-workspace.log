Name:         w-ws
Atespace:     default
Git Repositories:
  - origin (https://github.com/pallets/itsdangerous.git, branch: main)
MCP Registries:
  - Provider: google, Query: "mcp.tags:build"
MCP Servers:
  - docs: http://lab-mcp.ax-system.svc.cluster.local:8080/mcp
