Name:         ax-ws-task
Atespace:     default
Phase:        Running
Actor:        ax-ws-task
Worker IP:    10.244.0.40
Workspace:    ax-ws  path=/workspace
Command:      [sleep infinity]

Conditions:
  TYPE            STATUS  REASON         MESSAGE
