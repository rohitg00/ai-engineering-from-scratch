  "jsonrpc": "2.0",
  "id": 1,
  "method": "SendStreamingMessage",
  "params": {
    "message": {
      "messageId": "c15521b1-b3dc-450a-9daa-37e51b591d75",
      "role": "ROLE_USER",
      "parts": [
        {
          "text": "Run the full suite for payments-api at commit 9f3c2e1"
        }
      ]
    }
  }
}

