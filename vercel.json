{
  "buildCommand": "node site/build.js && node site/build-projects.js --strict && node site/build-agents.js && node site/clean-urls.js && node site/version-assets.js",
  "outputDirectory": "site",
  "framework": null,
  "installCommand": "echo skip",
  "routes": [
    {
      "src": "/lesson\\.html",
      "methods": [
        "GET",
        "HEAD"
      ],
      "dest": "/api/lesson?legacy=1"
    },
    {
      "src": "/certification\\.html",
      "methods": [
        "GET",
        "HEAD"
      ],
      "dest": "/api/certification?legacy=1"
    },
    {
      "src": "/",
      "dest": "/api/markdown?path=/"
    }
  ],
  "rewrites": [
    {
      "source": "/lesson",
      "destination": "/api/lesson"
    },
    {
      "source": "/certification",
      "destination": "/api/certification"
    },
    {
      "source": "/prereqs",
      "destination": "/api/markdown?path=/prereqs"
    },
    {
      "source": "/project",
      "destination": "/project.html"
    },
    {
      "source": "/about",
      "destination": "/api/markdown?path=/about"
    },
    {
      "source": "/catalog",
      "destination": "/api/markdown?path=/catalog"
    },
    {
      "source": "/glossary",
      "destination": "/api/markdown?path=/glossary"
    },
    {
      "source": "/path",
      "destination": "/api/markdown?path=/path"
    },
    {
      "source": "/roadmap",
      "destination": "/api/markdown?path=/roadmap"
    },
    {
      "source": "/developer",
      "destination": "/api/markdown?path=/developer"
    },
    {
      "source": "/docs",
      "destination": "/api/markdown?path=/docs"
    },
    {
      "source": "/contact",
      "destination": "/api/markdown?path=/contact"
    },
    {
      "source": "/privacy",
      "destination": "/api/markdown?path=/privacy"
    },
    {
      "source": "/sponsors",
      "destination": "/api/markdown?path=/sponsors"
    },
    {
      "source": "/assessment",
      "destination": "/assessment.html"
    },
    {
      "source": "/developers",
      "destination": "/api/markdown?path=/developers"
    },
    {
      "source": "/api",
      "destination": "/api/markdown?path=/api"
    },
    {
      "source": "/projects",
      "destination": "/api/markdown?path=/projects"
    },
    {
      "source": "/learning-paths",
      "destination": "/api/markdown?path=/learning-paths"
    },
    {
      "source": "/certifications",
      "destination": "/api/markdown?path=/certifications"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/.well-known/mcp.json",
      "destination": "/server.json"
    },
    {
      "source": "/api/openapi.json",
      "destination": "/openapi.json"
    },
    {
      "source": "/api/:missing*",
      "destination": "/api/not-found?api=1"
    },
    {
      "source": "/:missing*",
      "destination": "/api/not-found"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(png|jpg|jpeg|svg|webp|woff2|woff|ttf|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/certification-data.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/projects-data.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/build-meta.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    },
    {
      "source": "/(glossary|catalog|certifications|certification|assessment|path|prereqs|roadmap|about|developer|docs|contact|privacy|sponsors|projects|project|learning-paths)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/developer.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/agent-pages/:page.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/**/*.js": {
      "includeFiles": "{site/*.html,site/*-seo.json,site/agent-pages/*.md,generated/agent-content.json}"
    }
  },
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:page(about|catalog|glossary|prereqs|developer|contact|privacy|sponsors|projects|project|learning-paths|certifications|assessment).html",
      "destination": "/:page",
      "permanent": true
    },
    {
      "source": "/project",
      "missing": [
        {
          "type": "query",
          "key": "id"
        }
      ],
      "destination": "/projects",
      "permanent": false
    }
  ]
}
