  "steps": [
    {
      "title": "A task arrives",
      "say": "The run asks: What is 120 plus 15% tax, stored in kv? The buffer starts with one user message.",
      "focus": [
        "task",
        "messages"
      ],
      "flows": [
        "task-msg"
      ],
      "view": "iso"
    },
    {
      "title": "The model thinks",
      "say": "Each turn the model reads the whole buffer and emits a Thought then an Action. First thought in the run: store the base price.",
      "focus": [
        "messages",
        "model"
      ],
      "flows": [
        "msg-model",
        "model-reg"
      ],
      "readouts": {
        "turns": "1",
        "messages": "4"
      },
      "view": "iso"
    },
    {
      "title": "Call a tool",
      "say": "The action names a tool and inputs. The registry runs kv_set and the store writes base = 120.",
      "focus": [
        "model",
        "registry",
        "kvset",
        "kv"
      ],
      "flows": [
        "model-reg",
        "reg-kvset",
        "kvset-kv"
      ],
      "explode": 0.3,
      "readouts": {
        "stored": "base=120"
      },
      "view": "iso"
    },
    {
      "title": "Observe and loop",
      "say": "The result becomes an observation and joins the buffer. The ring is the loop: the model reads it all and goes again. Next it computes 120 * 0.15 = 18.0 and stores tax.",
      "focus": [
        "observe",
        "messages",
        "loop",
        "calc"
      ],
      "flows": [
        "calc-obs",
        "kvset-obs",
        "obs-msg",
        "reg-calc",
        "kvset-kv"
      ],
      "explode": 0.45,
      "readouts": {
        "turns": "3",
        "messages": "9",
        "stored": "tax=18.0"
      },
      "view": "iso"
    },
    {
      "title": "Read it back",
      "say": "The model confirms with kv_get base, which returns 120. The trace ends with 12 buffer entries.",
      "focus": [
        "registry",
        "kvget",
        "kv",
        "observe",
        "messages"
      ],
      "flows": [
        "reg-kvget",
        "kv-kvget",
        "kvget-obs",
        "obs-msg"
      ],
      "readouts": {
        "turns": "4",
        "messages": "12"
      },
      "view": "iso"
    },
    {
      "title": "Stop and answer",
      "say": "The model emits finish, the stop check passes, and the run prints: the total including 15% tax is 138.0. It used 5 turns of the budget.",
      "focus": [
        "model",
        "stopcheck",
        "bud-1",
        "bud-2",
        "bud-3",
        "bud-4",
        "bud-5",
        "answer"
      ],
      "flows": [
        "model-stop",
        "stop-budget",
        "stop-answer"
      ],
      "explode": 0.5,
      "readouts": {
        "turns": "5",
        "answer": "138.0"
      },
      "view": "iso"
    }
  ]
}