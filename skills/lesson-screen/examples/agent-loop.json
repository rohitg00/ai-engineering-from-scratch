  "flows": [
    {
      "id": "task-msg",
      "from": "task",
      "to": "messages",
      "label": "question"
    },
    {
      "id": "msg-model",
      "from": "messages",
      "to": "model",
      "label": "prompt"
    },
    {
      "id": "model-reg",
      "from": "model",
      "to": "registry",
      "label": "action"
    },
    {
      "id": "reg-calc",
      "from": "registry",
      "to": "calc",
      "label": "expr"
    },
    {
      "id": "reg-kvset",
      "from": "registry",
      "to": "kvset",
      "label": "key value"
    },
    {
      "id": "reg-kvget",
      "from": "registry",
      "to": "kvget",
      "label": "key"
    },
    {
      "id": "kvset-kv",
      "from": "kvset",
      "to": "kv",
      "label": "write"
    },
    {
      "id": "kv-kvget",
      "from": "kv",
      "to": "kvget",
      "label": "read"
    },
    {
      "id": "calc-obs",
      "from": "calc",
      "to": "observe",
      "label": "result"
    },
    {
      "id": "kvset-obs",
      "from": "kvset",
      "to": "observe",
      "label": "stored"
    },
    {
      "id": "kvget-obs",
      "from": "kvget",
      "to": "observe",
      "label": "value"
    },
    {
      "id": "obs-msg",
      "from": "observe",
      "to": "messages",
      "label": "observation"
    },
    {
      "id": "model-stop",
      "from": "model",
      "to": "stopcheck",
      "label": "turn end"
    },
    {
      "id": "stop-answer",
      "from": "stopcheck",
      "to": "answer",
      "label": "finish"
    },
    {
      "id": "stop-budget",
      "from": "stopcheck",
      "to": "bud-1",
      "label": "count"
    }
  ],
  "readouts": [
    {
      "id": "turns",
      "label": "turns used",
      "value": "0"
    },
    {
      "id": "messages",
      "label": "messages",
      "value": "1"
    },
    {
      "id": "tools",
      "label": "tools",
      "value": "3"
    },
    {
