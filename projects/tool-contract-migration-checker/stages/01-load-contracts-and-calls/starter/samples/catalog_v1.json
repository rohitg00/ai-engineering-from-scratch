{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "search_catalog",
  "type": "object",
  "properties": {
    "query": {
      "type": "string",
      "description": "Search query terms",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": ["electronics", "apparel", "books", "home"]
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "required": ["query"],
  "additionalProperties": true
}
